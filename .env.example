# App
APP_URL=https://your-domain-or-ngrok.io
ENV=production

# OpenAI
OPENAI_API_KEY=sk-...

# Shopify App (Public)
SHOPIFY_API_KEY=...
SHOPIFY_API_SECRET=...

# DB
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/shopify_ai

# Email (choose one path)
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
IMAP_HOST=imap.gmail.com
IMAP_USER=you@example.com
IMAP_PASS=your_app_password

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Billing (plan thresholds)
PLAN_BASIC_LIMIT=5000
PLAN_BASIC_PRICE=249
PLAN_PRO_LIMIT=15000
PLAN_PRO_PRICE=499
PLAN_SCALE_LIMIT=50000
PLAN_SCALE_PRICE=999
